# Pati Dostu — ortam değişkenleri örneği
# Kopyalayın: .env (kök) ve gerekirse apps/web/.env.local, apps/api/.env
# Gerçek değerleri asla commit etmeyin.

# --- Genel ---
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Veritabanı (geliştirmede yerel Supabase: `supabase start` çıktısı) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patidostu

# --- Supabase (Storage, imzalı yükleme URL'leri) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Better Auth ---
# Üretmek için: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Redis (Upstash REST; geliştirmede serverless-redis-http) ---
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev-token
# Socket.IO Redis adaptörü için doğrudan bağlantı
REDIS_URL=redis://localhost:6379

# --- E-posta (Resend; geliştirmede Mailpit SMTP 1025, arayüz http://localhost:8025) ---
RESEND_API_KEY=
EMAIL_FROM="Pati Dostu <iletisim@pati-dostu.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Web → API revalidate çağrısı ---
REVALIDATE_SECRET=

# --- Vercel Cron ---
CRON_SECRET=
