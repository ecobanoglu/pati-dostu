# Pati Dostu — ortam değişkenleri örneği
# Kopyalayın (PowerShell): Copy-Item .env.example .env
# Gerçek değerleri asla commit etmeyin.

# --- Genel ---
NODE_ENV=development
WEB_URL=http://localhost:3000
# API_URL: web sunucusunun API'ye eriştiği adres. NEXT_PUBLIC_API_URL: tarayıcının eriştiği adres
# (derleme sırasında koda gömülür; değiştirince web'i yeniden başlatın).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Web: diller ---
# Açık diller. Yayında yalnızca "tr"; İngilizceyi yerelde denemek için "tr,en".
# Değiştirince web'i yeniden başlatın (derleme sırasında okunur).
NEXT_PUBLIC_LOCALES=tr

# --- Veritabanı (PostgreSQL 17) ---
# Geliştirme: bilgisayarınızdaki Postgres. Yayın: Supabase (yalnızca veritabanı olarak).
#   DATABASE_URL → Supabase "Transaction pooler" adresi (6543 portu)
#   DIRECT_URL   → Supabase "Direct connection" adresi; yalnızca migration için
# Şifrede @ : / ? # % gibi karakterler varsa URL kodlaması yapın (ör. @ → %40).
DATABASE_URL=postgresql://postgres:SIFRE@localhost:5432/patidostu
DIRECT_URL=postgresql://postgres:SIFRE@localhost:5432/patidostu

# --- Dosya depolama (S3 uyumlu) ---
# Geliştirme: docker-compose'daki RustFS. Yayın: Cloudflare R2.
#   R2: S3_ENDPOINT=https://<hesap-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=patidostu
S3_SECRET_ACCESS_KEY=patidostu-dev-secret
S3_BUCKET=pati-dostu
# Dosyaların herkese açık adresi (R2'de özel alan adı, ör. https://cdn.pati-dostu.com)
S3_PUBLIC_URL=http://localhost:9000/pati-dostu

# --- Better Auth ---
# En az 32 karakter. Üretmek için (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Yayında web ve API'nin oturumu paylaşması için (ör. .pati-dostu.com); yerelde boş bırakın.
COOKIE_DOMAIN=
# Google ile giriş (isteğe bağlı). API'de iki değer girilince web'de NEXT_PUBLIC_GOOGLE_AUTH=true yapın;
# aksi hâlde "Google ile devam et" butonu gizli kalır.
# Google Cloud Console › OAuth istemcisi › yönlendirme adresi: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=false

# --- Redis (Upstash REST; geliştirmede serverless-redis-http) ---
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev-token
# Socket.IO Redis adaptörü için doğrudan bağlantı
REDIS_URL=redis://localhost:6379

# --- E-posta (Resend; geliştirmede Mailpit SMTP 1025, arayüz http://localhost:8025) ---
RESEND_API_KEY=
EMAIL_FROM="Pati Dostu <iletisim@pati-dostu.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Web → API revalidate çağrısı ---
REVALIDATE_SECRET=

# --- Vercel Cron ---
CRON_SECRET=

# --- Demo içerik (yalnız yerel; pnpm db:demo) ---
# Demo konuşmalar bu hesaba eklenir (Mesajlar sayfası dolu görünsün). Boşsa yalnız demo kullanıcılar arasında.
DEMO_INBOX_EMAIL=
