{
  "name": "pati-dostu",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pati-dostu/db db:generate",
    "db:migrate": "pnpm --filter @pati-dostu/db db:migrate",
    "db:seed": "pnpm --filter @pati-dostu/db db:seed",
    "db:studio": "pnpm --filter @pati-dostu/db db:studio",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
