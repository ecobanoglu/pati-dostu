{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS (apps/api)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist",
    "incremental": true,
    "types": ["node"]
  }
}
